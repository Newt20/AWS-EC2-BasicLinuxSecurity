{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyEC2RoleAndAccountRoot",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<BUCKET_NAME>",
        "arn:aws:s3:::<BUCKET_NAME>/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::<ACCOUNT_ID>:role/module17-ec2-s3-role",
            "arn:aws:iam::<ACCOUNT_ID>:user/module17-lab-user",
            "arn:aws:iam::<ACCOUNT_ID>:root"
          ]
        }
      }
    }
  ]
}
